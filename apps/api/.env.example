# Environnement : local | development | test | preprod | production
NODE_ENV=local
APP_PORT=8096
API_PREFIX=rni/api
CORS_ORIGINS=http://localhost:4200

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=rni
PG_PASSWORD=rni
PG_DATABASE=rni
PG_SSL=false
PG_LOGGING=false

# Développement uniquement (refusés hors local/development/test)
RNI_MOCK_AUTH=true
MOCK_NIGEND=100001
# Services externes simulés (REMOP, GEOLOC, Facade)
RNI_MOCK_EXTERNAL=true

# Cache applicatif en mémoire (une instance pm2) : activé par défaut
# CACHE_ENABLED=true
# CACHE_MAX_ENTRIES=5000
# CACHE_MAX_MB=128

# Certificats d'autorité internes pour les appels HTTPS sortants
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-interne.pem
