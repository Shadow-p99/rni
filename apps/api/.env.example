# Environnement : local | development | test | preprod | production
NODE_ENV=local
APP_PORT=8096
API_PREFIX=rni/api
CORS_ORIGINS=http://localhost:4200

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=rni
PG_PASSWORD=rni
PG_DATABASE=rni
PG_SSL=false
PG_LOGGING=false

# Développement uniquement (refusés hors local/development/test)
RNI_MOCK_AUTH=true
MOCK_NIGEND=100001
# Services externes simulés (REMOP, GEOLOC, Facade)
RNI_MOCK_EXTERNAL=true

# Cache applicatif en mémoire, invalidation partagée par PostgreSQL (LISTEN rni_cache)
# CACHE_ENABLED=true
# CACHE_NOTIFY=true
# CACHE_MAX_ENTRIES=5000
# CACHE_MAX_MB=128

# Processus : 1 (défaut en dév.), N ou auto ; arrêt gracieux ; migrations au démarrage
# WEB_CONCURRENCY=1
# SHUTDOWN_TIMEOUT_MS=25000
# SHUTDOWN_DELAY_MS=0
# MIGRATE_ON_START=false

# Base : connexions par processus, durée maximale d'une requête
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000

# Sécurité (production) : secret ajouté par Nginx, proxy de confiance
# PROXY_SHARED_SECRET=
# TRUST_PROXY=loopback

# Journaux : text (dév.) ou json (prod.)
# LOG_FORMAT=text
# LOG_LEVEL=log

# Certificats d'autorité internes pour les appels HTTPS sortants
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-interne.pem
