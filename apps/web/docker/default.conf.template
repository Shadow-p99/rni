# Nginx du conteneur rni-web. ${API_UPSTREAM} est substitué au démarrage (envsubst).
# L'authentification est assurée EN AMONT par le SSO, qui écrase les en-têtes nigend / cn / title :
# ce conteneur ne doit jamais être exposé directement aux navigateurs en production.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / { return 302 /rni/; }

    # API
    location /rni/api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
    }

    # Fichiers versionnés (hash dans le nom) : cache long
    location ~* ^/rni/.+\.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    # Application monopage : toute route inconnue renvoie index.html (jamais mis en cache)
    location /rni/ {
        try_files $uri $uri/ /rni/index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy same-origin always;
    }
    location = /rni/index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy same-origin always;
    }
}
