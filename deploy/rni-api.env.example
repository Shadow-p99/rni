# /etc/rni/rni-api.env — droits 0640 root:rni (contient des secrets). Variables complètes : README.
PG_HOST=pg.interne
PG_PORT=5432
PG_USER=rni_app
PG_PASSWORD=<secret>
PG_DATABASE=rni
PG_SSL=true
# PG_SSL_CA=/etc/ssl/certs/ca-interne.pem
# Connexions par processus : PG_POOL_MAX × WEB_CONCURRENCY × nombre de serveurs < max_connections
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# Processus HTTP (node:cluster) : 1, N ou auto (= nombre de cœurs)
WEB_CONCURRENCY=auto
# Migrations appliquées au démarrage (sinon : node dist/migrate.js lors du déploiement)
MIGRATE_ON_START=false

# Secret partagé avec Nginx (en-tête X-RNI-Proxy-Secret) : `openssl rand -hex 32`
PROXY_SHARED_SECRET=<secret>
# X-Forwarded-For n'est cru que du proxy local
TRUST_PROXY=loopback

LOG_FORMAT=json
LOG_LEVEL=log
CACHE_MAX_MB=128
